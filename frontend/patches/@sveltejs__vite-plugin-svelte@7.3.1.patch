+/**
+ * merges plain objects recursively, replaces arrays and other values, and never writes a prototype key
+ *
+ * @param {Record<string, any>} target
+ * @param {Record<string, any>} source
+ * @returns {Record<string, any>}
+ */
+function mergePlainObjects(target, source) {
+	/** @type {Record<string, any>} */
+	const merged = { ...target };
+	for (const key of Object.keys(source)) {
+		if (key === '__proto__' || key === 'constructor' || key === 'prototype') {
+			continue;
+		}
+		const value = source[key];
+		const isPlain = value != null && Object.getPrototypeOf(value) === Object.prototype;
+		merged[key] = isPlain ? mergePlainObjects(merged[key] ?? {}, value) : value;
+	}
+	return merged;
 }
 
