{
    "name": "hopin-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@12.18.0",
    "engines": {
        "node": "^24 || ^26"
    },
    "imports": {
        "#lib/*": "./src/lib/*"
    },
    "scripts": {
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
        "build": "vite build",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@jridgewell/sourcemap-codec": "^1.6.0",
        "@sveltejs/adapter-static": "^4.0.1",
        "@sveltejs/kit": "^3.2.0",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-svelte": "^3.24.1",
        "globals": "^17.14.0",
        "jsdom": "^31.0.1",
        "monocart-coverage-reports": "^3.2.1",
        "overnightworks-design": "https://github.com/overnightworks/design/releases/download/v0.40.0/overnightworks-design-0.40.0.tgz",
        "overnightworks-figure": "https://github.com/overnightworks/figure/releases/download/v0.9.0/overnightworks-figure-0.9.0.tgz",
        "overnightworks-speech-browser": "https://github.com/overnightworks/speech/releases/download/v0.22.3/overnightworks-speech-browser-0.22.3.tgz",
        "prettier": "^3.10.1",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.8",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.3.8",
        "vitest": "^5.1.0"
    }
}
